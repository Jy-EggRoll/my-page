---
import type { Locale } from '../config/i18n';
import { stringsFor } from '../data/strings';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = stringsFor(locale);
---

<section class="mt-12">
  <h2 class="text-sm font-semibold tracking-heading text-fg-subtle">{t.aboutLabel}</h2>
  <div class="mt-3 space-y-3">
    {
      t.about.map((paragraph) => (
        <p class="max-w-3xl leading-body text-fg-muted">{paragraph}</p>
      ))
    }
  </div>
</section>
