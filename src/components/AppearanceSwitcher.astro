---
import { appearanceGroupsFor } from '../config/appearance';
import type { Locale } from '../config/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const groups = appearanceGroupsFor(locale);
---

<!-- 只渲染分组本身，外层控件条由 SiteHeader 提供，好让语言切换也并入同一条 -->
{
  groups.map((group) => (
    <div class="appearance-group" role="group" aria-label={group.label}>
      <!-- 分组名是纯装饰：读屏只念 role=group 上的 aria-label，不重复念一遍 -->
      <span class="appearance-group-label" aria-hidden="true">{group.label}</span>
      {group.options.map((option) => (
        <button
          type="button"
          data-appearance-group={group.id}
          data-appearance-option={option.id}
          title={option.description}
          aria-pressed="false"
          class="appearance-option"
        >
          {option.label}
        </button>
      ))}
    </div>
  ))
}

<script>
  import { APPEARANCE } from '../config/appearance';

  const OPTION_SELECTOR = '[data-appearance-option]';

  function syncPressedState(): void {
    for (const group of APPEARANCE) {
      const current = document.documentElement.getAttribute(group.attribute);
      // 注意：data-appearance-group 与 data-appearance-option 都写在同一个按钮上，
      // 所以这里必须是「同一元素」的复合选择器。写成后代选择器（中间留空格）会
      // 一个都匹配不到，aria-pressed 永远是 false，选中态就永远不显示。
      document
        .querySelectorAll<HTMLButtonElement>(
          `[data-appearance-group="${group.id}"]${OPTION_SELECTOR}`,
        )
        .forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.appearanceOption === current));
        });
    }
  }

  function applyOption(group: (typeof APPEARANCE)[number], id: string): void {
    document.documentElement.setAttribute(group.attribute, id);
    try {
      localStorage.setItem(group.storageKey, id);
    } catch (error) {
      /* 存不下只影响下次访问的默认值，本次切换照常生效 */
    }
    syncPressedState();
  }

  document.querySelectorAll<HTMLButtonElement>(OPTION_SELECTOR).forEach((button) => {
    button.addEventListener('click', () => {
      const group = APPEARANCE.find(
        (candidate) => candidate.id === button.dataset.appearanceGroup,
      );
      const id = button.dataset.appearanceOption;
      if (group !== undefined && id !== undefined) applyOption(group, id);
    });
  });

  // 内联脚本通常已经写好属性；这里兜底处理脚本被阻止或属性缺失的情况。
  for (const group of APPEARANCE) {
    if (!document.documentElement.hasAttribute(group.attribute)) {
      document.documentElement.setAttribute(group.attribute, group.defaultId);
    }
  }
  syncPressedState();
</script>
