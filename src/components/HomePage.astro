---
import type { Locale } from '../config/i18n';
import { SITE_BRAND_LATIN, SITE_LINKS } from '../config/site';
import { CHROME_COLUMNS, resumeFor } from '../data/resume';
import { stringsFor } from '../data/strings';
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from './Contact.astro';
import ResumeSection from './ResumeSection.astro';
import SiteHeader from './SiteHeader.astro';
import StatsEmbed from './StatsEmbed.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = stringsFor(locale);
const resume = resumeFor(locale);
const year = new Date().getFullYear();
---

<BaseLayout locale={locale} title={t.pageTitle} description={t.pageDescription}>
  <!--
    共享外壳：整页只有一份 DOM，三种版式由 [data-layout] 的 CSS 决定编排。
    .site-header / .rail-nav 的归属位置也由 CSS 摆放（终端版式把页头移进左侧栏）。
  -->
  <div class="layout-shell">
    <SiteHeader locale={locale} />

    <nav class="rail-nav" aria-label={t.railNavLabel}>
      {
        resume.sections.map((section) => (
          <a class="rail-link" href={`#${section.id}`}>
            <span class="rail-path" aria-hidden="true">{`~/${section.id}`}</span>
            <span class="rail-label">{section.label}</span>
          </a>
        ))
      }
    </nav>

    <section class="section-shell hero" style={`--cell-columns:${CHROME_COLUMNS.hero}`}>
      <div class="section-masthead">
        <span class="section-path" aria-hidden="true">~/intro</span>
      </div>
      <div class="section-body">
        <!-- headline 是「一句话的两个分句」，两行同级呈现，不是标题加副标题 -->
        <h1 class="hero-headline">
          {resume.headline.map((line) => <span class="hero-line">{line}</span>)}
        </h1>
        <div class="hero-actions">
          <a class="btn-primary" href={SITE_LINKS.github}>{t.linkGithub}</a>
          <a class="btn-secondary" href={SITE_LINKS.blog}>{t.linkBlog}</a>
        </div>
      </div>
      <!-- 首屏视觉锚点：品牌拉丁字标做成的水印，纯装饰，不随语言变化 -->
      <span class="hero-mark" aria-hidden="true">{SITE_BRAND_LATIN}</span>
    </section>

    <section
      data-section-id="summary"
      class="section-shell"
      style={`--cell-columns:${CHROME_COLUMNS.summary}`}
    >
      <div class="section-masthead">
        <h2 class="section-label">{t.summaryLabel}</h2>
        <span class="section-path" aria-hidden="true">~/summary</span>
      </div>
      <div class="section-body">
        {resume.summary.map((paragraph) => <p class="prose">{paragraph}</p>)}
      </div>
    </section>

    {
      resume.sections.map((section) => (
        <ResumeSection section={section} />
      ))
    }

    <Contact locale={locale} />
    <StatsEmbed locale={locale} />

    <!-- 左右两栏：左「© 年份 品牌」，右「构建说明」；窄屏由 flex-wrap 自动堆叠 -->
    <footer class="site-footer">
      <span class="site-footer-credit">© {year} {t.brand}</span>
      <span class="site-footer-note">{t.footer}</span>
    </footer>
  </div>
</BaseLayout>
