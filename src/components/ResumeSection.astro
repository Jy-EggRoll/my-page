---
import { columnsFor, emphasisFor, hueFor, type ResumeSection as Section } from '../data/resume';
import TagChips from './TagChips.astro';

interface Props {
  section: Section;
}

const { section } = Astro.props;
const LEVELS = [1, 2, 3, 4, 5];
/** 终端版式的路径标签，由板块 id 派生，不是另写的文案 */
const path = `~/${section.id}`;
/** 只把色相交给数据；未登记的板块不加这个变量，CSS 会跟随主题主色 */
const hue = hueFor(section.id);
const shellStyle = [`--cell-columns:${columnsFor(section.id)}`, hue === undefined ? null : `--section-hue:${hue}`]
  .filter((part) => part !== null)
  .join(';');
---

<!--
  共享 DOM：一份标记要同时喂饱三种版式，所以这里只放「三种编排都需要的构件」，
  由 [data-layout] 的 CSS 决定谁可见、怎么排。条目元素都带语义类（entry-*），
  版式 CSS 因此不必依赖 Tailwind 的原子类名。
  data-section-id / data-entry / data-chip 是回归脚本的稳定钩子，改名会让安全网失效。
-->
<section
  data-section-id={section.id}
  data-emphasis={emphasisFor(section.id)}
  class="section-shell"
  style={shellStyle}
>
  <div class="section-masthead">
    <h2 class="section-label">{section.label}</h2>
    <span class="section-path" aria-hidden="true">{path}</span>
  </div>

  <div class="section-body">
    {
      section.layout === 'timeline' && (
        <ol class="entry-list entry-list--timeline">
          {section.entries.map((entry, index) => (
            <li data-entry data-reveal style={`--reveal-i:${index}`} class="entry-item entry-item--timeline">
              <p class="entry-meta">{entry.meta}</p>
              <div class="entry-timeline-body">
                <h3 class="entry-title">{entry.title}</h3>
                {entry.subtitle && <p class="entry-subtitle">{entry.subtitle}</p>}
                {entry.detail && <p class="entry-detail">{entry.detail}</p>}
              </div>
            </li>
          ))}
        </ol>
      )
    }

    {
      section.layout === 'grid' && (
        <ul class="entry-list entry-list--grid">
          {section.entries.map((entry, index) => (
            <li data-entry data-reveal style={`--reveal-i:${index}`} class="entry-item entry-item--grid">
              <h3 class="entry-title">
                {entry.href ? (
                  <a
                    href={entry.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="entry-link"
                  >
                    {entry.title}
                  </a>
                ) : (
                  entry.title
                )}
              </h3>
              {entry.subtitle && <p class="entry-subtitle">{entry.subtitle}</p>}
              {entry.meta && <p class="entry-meta">{entry.meta}</p>}
              {entry.detail && <p class="entry-detail">{entry.detail}</p>}
            </li>
          ))}
        </ul>
      )
    }

    {
      section.layout === 'meter' && (
        <ul class="entry-list entry-list--meter">
          {section.entries.map((entry, index) => (
            <li data-entry data-reveal style={`--reveal-i:${index}`} class="entry-item entry-item--meter">
              <div class="entry-meter-head">
                <span class="entry-title">{entry.title}</span>
                {entry.subtitle && <span class="entry-subtitle">{entry.subtitle}</span>}
                {entry.level !== undefined && (
                  <span class="entry-level" role="img" aria-label={`${entry.level}/${LEVELS.length}`}>
                    {LEVELS.map((step) => (
                      <span
                        aria-hidden="true"
                        class={`entry-level-cell ${step <= (entry.level ?? 0) ? 'is-on' : ''}`}
                      />
                    ))}
                  </span>
                )}
              </div>
              {entry.tags && (
                <div class="entry-tags">
                  <TagChips tags={entry.tags} />
                </div>
              )}
            </li>
          ))}
        </ul>
      )
    }

    {
      section.layout === 'tags' && (
        <ul class="entry-list entry-list--tags">
          {section.entries.map((entry, index) => (
            <li data-entry data-reveal style={`--reveal-i:${index}`} class="entry-item entry-item--tags">
              <span class="entry-title">{entry.title}</span>
              {entry.tags && <TagChips tags={entry.tags} />}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
