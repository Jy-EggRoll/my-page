---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '../config/i18n';
import { stringsFor } from '../data/strings';
import AppearanceSwitcher from './AppearanceSwitcher.astro';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<header class="site-header">
  <a class="site-brand" href={getRelativeLocaleUrl(locale, '/')}>
    {stringsFor(locale).brand}
  </a>
  <!-- 四个维度收进同一条控件条：主题 / 明暗 / 版式 / 语言 -->
  <div class="appearance-bar">
    <AppearanceSwitcher locale={locale} />
    <LangSwitcher locale={locale} />
  </div>
</header>
