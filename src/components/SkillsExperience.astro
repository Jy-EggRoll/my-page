---
import type { Locale } from '../config/i18n';
import { stringsFor } from '../data/strings';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = stringsFor(locale);
---

<section class="mt-12">
  <h2 class="text-sm font-semibold tracking-heading text-fg-subtle">{t.skillsLabel}</h2>

  <div class="mt-4 grid gap-5 sm:grid-cols-3">
    {
      t.skillGroups.map((group) => (
        <div>
          <h3 class="text-xs font-medium">{group.label}</h3>
          <div class="mt-2 flex flex-wrap gap-2">
            {group.items.map((item) => (
              <span class="rounded-chip bg-accent-soft px-3 py-1 text-xs font-medium text-accent">
                {item}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  <!-- 时间线用「左列时间 / 右列内容」的两列布局，窄屏自动堆叠，
       比绝对定位的圆点更稳、也无需写死偏移量 -->
  <ol class="mt-8 space-y-6">
    {
      t.timeline.map((entry) => (
        <li class="grid gap-1 sm:grid-cols-[9rem_1fr] sm:gap-5">
          <p class="font-mono text-xs leading-body text-fg-subtle">{entry.period}</p>
          <div class="sm:border-l sm:border-border sm:pl-5">
            <h3 class="text-sm font-semibold">{entry.title}</h3>
            <p class="mt-1 leading-body text-fg-muted">{entry.detail}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>
