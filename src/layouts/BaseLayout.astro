---
import '../styles/global.css';
import { APPEARANCE, APPEARANCE_INIT, resolveDefault } from '../config/appearance';
import { DEFAULT_LOCALE, LOCALES, LOCALE_META, type Locale } from '../config/i18n';
import { withBase } from '../utils/url';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
}

const { title, description, locale } = Astro.props;

const initialAttributes: Record<string, string> = {};
for (const group of APPEARANCE) {
  initialAttributes[group.attribute] = resolveDefault(group);
}

/**
 * 同一页面在指定语言下的绝对地址，用于 canonical 与 hreflang。
 * getRelativeLocaleUrl 返回的地址**已经带上了 base**（子路径），不要再套 withBase，
 * 否则会变成 /my-page/my-page/...。origin 取自 Astro.url，不写死域名。
 */
function absoluteHomeUrl(target: Locale): string {
  return new URL(getRelativeLocaleUrl(target, '/'), Astro.url.origin).href;
}
---

<!doctype html>
<html lang={LOCALE_META[locale].htmlLang} {...initialAttributes}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={absoluteHomeUrl(locale)} />
    {
      LOCALES.map((target) => (
        <link
          rel="alternate"
          hreflang={LOCALE_META[target].htmlLang}
          href={absoluteHomeUrl(target)}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={absoluteHomeUrl(DEFAULT_LOCALE)} />

    <!--
      必须内联且同步执行：要在首次绘制之前把用户上次选的外观写回 <html>，
      否则会先闪一下默认外观再跳变（FOUC）。模块化脚本被延迟执行，做不到这点，
      所以这里刻意保留一段重复逻辑。属性名与默认值都来自配置，不写死。
    -->
    <script is:inline define:vars={{ groups: APPEARANCE_INIT }}>
      (function () {
        var root = document.documentElement;
        groups.forEach(function (group) {
          var value = null;
          try {
            value = localStorage.getItem(group.storageKey);
          } catch (error) {
            /* 隐私模式下 localStorage 可能不可用，继续走默认值 */
          }
          if (!value && group.media && window.matchMedia(group.media).matches) {
            value = group.mediaId;
          }
          root.setAttribute(group.attribute, value || group.defaultId);
        });
      })();
    </script>
  </head>
  <body class="min-h-screen text-fg antialiased transition-colors ease-standard">
    <!-- 装饰性背景层：内容由各主题通过 --backdrop-layer 提供，其余主题为 none -->
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 -z-10 [background-image:var(--backdrop-layer)] [background-repeat:no-repeat]"
    >
    </div>
    <slot />

    <!--
      滚动揭示的接管脚本（Astro 会打包成模块，执行时机在 DOM 解析完之后）。
      只在「浏览器有 IntersectionObserver + 用户没有要求减动效」时才给 <html> 加 .reveal-ready；
      任何一条不成立就不加，motion.css 里的隐藏态因此永远不会生效，内容全部自然可见。
      不要与上面那段 is:inline 的防闪烁脚本合并 —— 那段必须同步内联，这段必须是延迟模块。
    -->
    <script>
      const REVEAL_READY_CLASS = 'reveal-ready';
      const REVEAL_DONE_CLASS = 'is-revealed';

      function setupScrollReveal(): void {
        const root = document.documentElement;
        // 静态页没有客户端重渲染，查询一次即可；元素即使日后被替换，这里也不会抛错，
        // 只是它不再被观察（IO 只对 observe 过的目标回调）。
        const targets = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
        if (targets.length === 0) return;

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add(REVEAL_DONE_CLASS);
              observer.unobserve(entry.target); // 一次性：揭示后不逆转，回滚再滚回来不重播
            }
          },
          // 视口下沿内缩 8%：元素在真正贴上边缘之前就开始淡入，去掉「滚到了才动」的迟滞感
          { rootMargin: '0px 0px -8% 0px' },
        );

        /*
         * 顺序很关键：先把「此刻已经在视口里」的元素直接标成已揭示，再加 .reveal-ready。
         * 两件事在同一个同步任务里完成，浏览器只会重算一次样式 —— 首屏元素从来没有过
         * 「隐藏」这个计算值，不会出现「先显示 → 再淡出 → 再淡入」的闪烁（深链接直接
         * 落在半页时同理）。视口判定用完整视口，比 IO 的 -8% 更宽松，两者不会互相打架。
         */
        const viewportHeight = window.innerHeight;
        for (const target of targets) {
          const rect = target.getBoundingClientRect();
          if (rect.top < viewportHeight && rect.bottom > 0) {
            target.classList.add(REVEAL_DONE_CLASS);
            continue;
          }
          observer.observe(target);
        }

        root.classList.add(REVEAL_READY_CLASS);
      }

      /*
       * 偏好只在这里读一次，**运行中**改成「减少动效」由 motion.css 末尾的 reduce 段实时兜底：
       * 那段会强制 opacity: 1 / transform: none / transition: none，隐藏态当场失效。
       * 所以不需要再挂 matchMedia 的 change 监听 —— 少一份 JS 状态就少一处与 CSS 不一致的机会。
       */
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (!reduceMotion.matches && 'IntersectionObserver' in window) setupScrollReveal();
    </script>
  </body>
</html>
